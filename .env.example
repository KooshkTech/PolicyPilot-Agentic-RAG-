# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Required for local dev: the agent calls Groq (Llama) directly via the Groq API.
GROQ_API_KEY=

# local (default) = Chroma + Groq API, everything runs on this machine.
# databricks      = Vector Search + Model Serving (only once a workspace is provisioned).
PP_ENV=local

# SEC requires a descriptive User-Agent with a real contact on all EDGAR requests.
SEC_EDGAR_USER_AGENT="PolicyPilot research prototype you@example.com"

# --- databricks (unused until PP_ENV=databricks) ---
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# Override these to match your own Databricks resources.
PP_UC_CATALOG=policypilot_dev
PP_UC_SCHEMA=filings
PP_VECTOR_SEARCH_ENDPOINT=policypilot
PP_VECTOR_SEARCH_INDEX=policypilot_dev.filings.filings_index
# Optional writable data directory (use an absolute path).
# PP_DATA_DIR=/absolute/path/to/data
